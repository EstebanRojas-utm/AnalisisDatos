es_outlier_fila <- apply(dataH_imputed[quantitative_vars_names], 1, function(row) {
any(sapply(quantitative_vars_names, function(col) {
x <- dataH_imputed[[col]]
q1 <- quantile(x, 0.25)
q3 <- quantile(x, 0.75)
iqr <- q3 - q1
row[col] < (q1 - 1.5 * iqr) | row[col] > (q3 + 1.5 * iqr)
}))
})
dataClean2 <- dataH_imputed[!es_outlier_fila, ]
summary(dataClean)
summary(dataClean2)
