nrow = length(freqIndx),
nol =  dimPXY[2],
byrow = FALSE)
freqy_mat
freqx_mat
N <- length(X)
mxy_mat <- (freqx_mat*freqy_mat)/N
print("Matriz P ")
print(pxy_mat)
print("Matriz M")
print(mxy_mat)
