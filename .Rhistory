#Funcion cuartiles
remove_outliers_median <- function(x) {
q1 <- quantile(x, 0.25, na.rm = TRUE)
q3 <- quantile(x, 0.75, na.rm = TRUE)
iqr <- q3 - q1
lower_bound <- q1 - 1.5 * iqr
upper_bound <- q3 + 1.5 * iqr
# Si es outlier se reemplaza por la mediana
med <- median(x, na.rm = TRUE)
ifelse(x < lower_bound | x > upper_bound, , x)
}
