q3 <- quantile(x, 0.75)
iqr <- q3 - q1
row[col] < (q1 - 1.5 * iqr) | row[col] > (q3 + 1.5 * iqr)
}))
})
# Aplicamos la corrección de outliers a las variables cuantitativas
