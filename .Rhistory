minDispl <- min(mpg$displ)
maxDispl <- max(mpg$displ)
cat("El valor minimo es", minDispl, "Y el valor maximo es ", maxDispl, "\nEl valor promedio es", meanDispl, "y la desviación estandar es ", stdDispl)
#year
