# Definición de listas
quantitative_vars_names <- c('AGE', 'BILIRUBIN', 'ALK_PHOSPHATE', 'SGOT', 'ALBUMIN', 'PROTIME')
qualitative_vars_names <- c('CLASS', 'SEX', 'STEROID', 'ANTIVIRALS', 'FATIGUE', 'MALAISE',
'ANOREXIA', 'LIVERB', 'LIVERF', 'SPLEENP', 'SPIDERS', 'ASCITES',
'VARICES', 'HISTOLOGY')
#Tratamiento datos
#Funcion para la moda
get_mode <- function(v) {
v_clean <- v[!is.na(v)]
uniqv <- unique(v_clean)
uniqv[which.max(tabulate(match(v_clean, uniqv)))]
}
dataH_imputed <- dataH %>%
#Imputación de categóricas con la MODA
mutate(across(all_of(qualitative_vars_names), ~ ifelse(is.na(.), get_mode(.), .))) %>%
#Imputación de cuantitativas con la MEDIANA
mutate(across(all_of(quantitative_vars_names), ~ ifelse(is.na(.), median(., na.rm = TRUE), .))) %>%
#Convertir cualitativas a factor
mutate(across(all_of(qualitative_vars_names), as.factor))
cat("\n--- Resumen tras imputar NAs (Moda / Mediana) ---\n")
summary(dataH_imputed)
#Remover datos extremos
#Funcion cuartiles
remove_outliers_median <- function(x) {
q1 <- quantile(x, 0.25, na.rm = TRUE)
q3 <- quantile(x, 0.75, na.rm = TRUE)
iqr <- q3 - q1
lower_bound <- q1 - 1.5 * iqr
upper_bound <- q3 + 1.5 * iqr
# Si es outlier se reemplaza por la mediana
med <- median(x, na.rm = TRUE)
ifelse(x < lower_bound | x > upper_bound, med, x)
}
summary(dataH)
# Aplicamos la corrección de outliers a las variables cuantitativas
dataClean <- dataH %>%
mutate(across(all_of(quantitative_vars_names), remove_outliers_median))
cat("\n Resumen Dataset (sin Outliers extremos)\n")
summary(dataClean)
x11()
plot_missing(dataH)
