h_ak <- calcular_H(ak)
h_ak_c <- calcular_H_cond(ak, clase)
i_ak_c <- h_ak - h_ak_c
mmi <- (2 * i_ak_c) / (h_ak + h_clase)
resultados <- rbind(resultados, data.frame(
