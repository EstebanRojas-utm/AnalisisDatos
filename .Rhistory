meanyear <- mean(mpg$year)
minyear <- min(mpg$year)
maxyear <- max(mpg$year)
cat("El valor minimo es", minyear, "Y el valor maximo es ", maxyear, "\nEl valor promedio es", meanyear, "y la desviación estandar es ", stdyear)
